<?xml version="1.0"?>
<robot name="sentry">
 <link name="base_footprint" />
  
  <!-- base link -->
  <link name="base_link">
  <visual>
    <origin xyz="0 0 0.0" rpy="0 0 0" />
    <geometry>
      <cylinder length="0.45" radius="0.30" />
    </geometry>
    <material name="blue">
      <color rgba="0.1 0.1 1.0 0.5" />
    </material>
  </visual>
  </link>
  
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.225" rpy="0 0 0" />
  </joint>

<!-- station_link -->
  <link name="station_link">
  <visual>
    <origin xyz="0 0 0.0" rpy="0 0 0" />
    <geometry>
      <cylinder length="0.11" radius="0.01" />
    </geometry>
    <material name="blue">
      <color rgba="0.1 0.1 1.0 0.5" />
    </material>
  </visual>
  </link>
  
  <joint name="station_joint" type="fixed">
    <parent link="base_link" />
    <child link="station_link" />
    <origin xyz="0.0 0.0 0.28" rpy="0 0 0" />
  </joint>


  <!-- laser link -->
  <link name="laser_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <cylinder length="0.026" radius="0.026" />
    </geometry>
    <material name="black">
      <color rgba="0.0 0.0 0.0 0.5" />
    </material>
  </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="station_link" />
    <child link="laser_link" />
    <origin xyz="0 0 0.068" rpy="0 0 0" />
  </joint>

  <!-- imu_link -->
  <link name="imu_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <!-- <cylinder length="0.026" radius="0.026" /> -->
      <box size="0.065 0.065 0.0395" />
    </geometry>
    <material name="black">
      <color rgba="0.0 0.0 0.0 0.5" />
    </material>
  </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="laser_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.03275" rpy="0 0 0" />
  </joint>

</robot>