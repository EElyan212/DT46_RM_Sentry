  <!-- Frame imu_up (dummy link + fixed joint) -->
  <link name="imu_up">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <!-- classis -> imu_up（与 gimbal、muzzle、camera 并列） -->
  <joint name="imu_up_joint" type="fixed">
    <origin xyz="0.0326601 0 0.3242652" rpy="0 0.00152726 0"/>
    <parent link="classis"/>
    <child link="imu_up"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- classis -> camera（与 gimbal、muzzle、imu_up 并列） -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0326601 0 0.3767652" rpy="0 0.00152726 0"/>
    <parent link="classis"/>
    <child link="camera"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- classis -> muzzle（与 gimbal、camera、imu_up 并列） -->
  <joint name="muzzle_joint" type="fixed">
    <origin xyz="0 -0.105 0.306815" rpy="0 0.00152726 0"/>
    <parent link="classis"/>
    <child link="muzzle"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- Joint from classis to gimbal（classis 作为其余坐标系的父坐标系，各子坐标系并列） -->
  <joint name="gimbal_yaw" type="revolute">
    <origin xyz="0 0 0.131815" rpy="0 0 0"/>
    <parent link="classis"/>
    <child link="gimbal"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-3.141592653589793" upper="3.141592653589793"/>
