  </link>
  <joint name="imu_up_frame" type="fixed">
    <origin xyz="0 -0 -0.0525" rpy="-0 -0 -0"/>
    <parent link="camera"/>
    <child link="imu_up"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- Joint from muzzle to camera -->
  <joint name="camera" type="revolute">
    <origin xyz="0.0325532 0.105 0.07 " rpy="0 0 0"/>
    <parent link="muzzle"/>
    <child link="camera"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="0"/>
  </joint>
  <!-- Joint from gimbal to muzzle -->
  <joint name="gimbal_pitch" type="revolute">
    <origin xyz="0 -0.105 0.175" rpy="0 0.00152726 -0"/>
    <parent link="gimbal"/>
    <child link="muzzle"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10" lower="-3.141592653589793" upper="3.141592653589793"/>
  </joint>
  <!-- Joint from classis to gimbal -->
  <joint name="gimbal_yaw" type="revolute">
    <origin xyz="0 0 0.131815" rpy="0 0 0"/>
    <parent link="classis"/>
    <child link="gimbal"/>
