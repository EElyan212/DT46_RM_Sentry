<?xml version="1.0" ?>
<!-- Generated using onshape-to-robot -->
<!-- Onshape https://cad.onshape.com/documents/be6f6668384a7c322284fa37/w/70a8de88a5fe65e3dfa6f16d/e/c49365e92846c43250251d29 -->
<robot name="sentry">
  <!-- Frame livox_frame (dummy link) 作为整棵 TF 树的基坐标系 -->
  <link name="livox_frame">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <!-- 虚拟的 base_footprint，代表机器人在地面的投影 -->
  <link name="base_footprint"/>

  <!-- livox_frame -> base_footprint
       安装位置（livox_frame 原点在 base_footprint 中的平移，ROS/REP-103：x 前、y 左、z 上）：
         x = +0.0845   前方 84.5 mm
         y = -0.12702  右侧 127.02 mm（右侧为 -y）
         z = +0.22515  高度 225.15 mm
       安装姿态（以与 base_footprint 朝向一致为 (yaw, pitch, roll) = (0, 0, 0)）：
         1) 以前向为观测方向，绕 roll(x) 轴顺时针 20.01°  -> roll = +0.349240
         2) 俯视视角，绕 yaw(z) 轴顺时针 150°              -> yaw  = -2.617994
         即 (yaw, pitch, roll) = (-2.617994, 0, +0.349240)
         R_base<-livox = Rz(-150°) * Rx(+20.01°)
       本关节以 livox_frame 为父、base_footprint 为子，origin 只写上面的逆变换：
         R_livox<-base = Rx(-20.01°) * Rz(+150°)
         其 ZYX 欧拉角（URDF rpy 顺序为 roll pitch yaw）= (0.305506, 0.171938, 2.644529)
         平移 t = -R_livox<-base * p = (0.009669, -0.220104, -0.159460) -->
  <joint name="livox_frame_joint" type="fixed">
    <origin xyz="0.009669 -0.220104 -0.159460" rpy="0.305506 0.171938 2.644529"/>
    <parent link="livox_frame"/>
    <child link="base_footprint"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- base_footprint 作为父节点，连接到底盘 classis（classis 原点离地 5cm） -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="classis"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <!-- Link classis -->
  <link name="classis">
    <inertial>
