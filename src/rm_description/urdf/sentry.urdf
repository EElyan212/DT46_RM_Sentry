<robot name="sentry">
  <!-- 虚拟的 base_footprint，代表机器人在地面的投影 -->
  <link name="base_footprint"/>

  <!-- 将 base_footprint 作为父节点，连接到现有的底盘 classis -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="classis"/>
